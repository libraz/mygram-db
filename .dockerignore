# Local secrets. The builder stage runs COPY . ., so anything left here reaches
# a build layer even though the runtime stage copies only the install tree.
.env
.env.*
!.env.example

# Build artifacts. The glob covers the out-of-tree directories (build-linux,
# build-asan, ...) that would otherwise be sent as build context.
build/
build-*/
*.o
*.a
*.so
*.dylib

# Local working notes
backup/

# Git
.git/
.github/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
docs/
*.md
!README.md

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Testing
tests/data/
coverage/
*.gcda
*.gcno
*.gcov

# MacOS
.DS_Store

# Temporary files
tmp/
temp/
*.tmp
*.log

# Other
scripts/
