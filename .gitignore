# Local scratch / backup area (never committed)
.backup/

# Build directories
build/
build-*/
cmake-build-*/
dist/
*.o
*.a
*.so
*.dylib

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# Generated files
*.log
*.out
core
core.*

# Binaries
mygramdb
mygram-cli
*.exe

# Dependencies
third_party/*
!third_party/CMakeLists.txt

# Snapshots & Data
/var/
*.snap
snapshots/
tmp/

# Test outputs
/[Tt]esting/
*.gcov
*.gcda
*.gcno

# Coverage reports
coverage/
*.info

# Docker
.env
.env.prod
.env.local
docker-compose.override.yml
logs/

# SQL files (may contain sensitive data)
*.sql
!support/docker/mysql/init/*.sql
!e2e/docker/mysql-init/*.sql
!e2e/docker/mariadb-init/*.sql

# IDE
.idea/
*.swp
*.swo
*~
*.bak

# OS
.DS_Store

# Cache
.cache/

# Tools
.claude/
.serena/
.wrangler/
.act/

# Config (local customizations)
CLAUDE.md
.test-diff.conf
.secrets

# Backup
backup/

# Python (support/benchmark, support/seed)
__pycache__/
*.py[oc]
*.egg-info
.venv/
.python-version
dumps/
# The matrix runner gives each database flavor its own dump directory so the
# runs cannot read each other's snapshots.
dumps-*/
# Dependencies are locked by rye (requirements*.lock); a uv lockfile would be
# a second, conflicting source of truth.
uv.lock

# E2E test results
e2e/results/reports/*.xml
e2e/results/metrics/
e2e/.venv/
e2e/__pycache__/
e2e/**/__pycache__/
e2e/*.egg-info/
e2e/.mypy_cache/
e2e/.ruff_cache/
e2e/.pytest_cache/
# Benchmark baselines are machine-specific; they are produced locally by
# benchmark_suite.py --save-baseline and are not shared through the repository.
e2e/results/baselines/*.json
